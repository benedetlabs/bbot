# Copie para infra/02-releases/terraform.tfvars (nunca comite no Git!)
github_username         = "benedetlabs"
github_token            = "ghp_SEU_GITHUB_TOKEN_WRITE_E_READ_PACKAGES"
auto_build_images       = true

# A tag da imagem é o hash do código de cada app. Não defina image_tag aqui.
projects = {
  "secret-app" = {
    enabled        = true
    replicas       = 2
    signing_secret = "SEU_SLACK_SECRET_SIGNING"
    bot_token      = "xoxb-SEU_SLACK_SECRET_BOT_TOKEN"
    client_id      = "SEU_SLACK_CLIENT_ID"
    client_secret  = "SEU_SLACK_CLIENT_SECRET"
  }
  "queue-app" = {
    enabled        = false # Desativado: não faz build nem cria pods no cluster até você mudar para true!
    replicas       = 2
    signing_secret = ""
    bot_token      = ""
  }
  "todo-app" = {
    enabled        = false # Desativado: não faz build nem cria pods no cluster até você mudar para true!
    replicas       = 2
    signing_secret = ""
    bot_token      = ""
  }
  "gatekeep-app" = {
    enabled        = false # Ative para compilar e publicar o Gatekeep
    replicas       = 2
    signing_secret = "SEU_GATEKEEP_SIGNING_SECRET"
    bot_token      = "xoxb-SEU_GATEKEEP_BOT_TOKEN"
  }
}

worker = {
  enabled  = true
  replicas = 2
}
