{
  "workspace": [
    "./apps/secret-app",
    "./apps/queue-app",
    "./apps/todo-app",
    "./apps/outbox-worker",
    "./packages/db",
    "./packages/outbox",
    "./packages/crypto",
    "./packages/slack-kit",
    "./packages/billing"
  ],
  "minimumDependencyAge": "P14D",
  "nodeModulesDir": "none",
  "imports": {
    "@suite/db": "./packages/db/mod.ts",
    "@suite/outbox": "./packages/outbox/mod.ts",
    "@suite/crypto": "./packages/crypto/mod.ts",
    "@suite/slack-kit": "./packages/slack-kit/mod.ts",
    "@suite/billing": "./packages/billing/mod.ts",
    "postgres": "npm:postgres@3.4.4",
    "hono": "npm:hono@4.5.8",
    "zod": "npm:zod@3.23.8",
    "chrono-node": "npm:chrono-node@2.7.6",
    "@std/assert": "jsr:@std/assert@1.0.11",
    "@std/testing": "jsr:@std/testing@1.0.9"
  },
  "tasks": {
    "test": "deno test -A",
    "check": "deno check **/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "dev:secret": "deno run --allow-net --allow-env --watch apps/secret-app/main.ts",
    "dev:queue": "deno run --allow-net --allow-env --watch apps/queue-app/main.ts",
    "dev:todo": "deno run --allow-net --allow-env --watch apps/todo-app/main.ts",
    "dev:worker": "deno run --allow-net --allow-env --watch apps/outbox-worker/main.ts",
    "simulate": "deno run --allow-net --allow-env scripts/simulate_slack.ts"
  },
  "lint": {
    "rules": {
      "exclude": ["no-slow-types"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  }
}
